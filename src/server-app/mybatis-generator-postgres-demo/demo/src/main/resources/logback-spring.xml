<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <springProperty scope="context" name="LOGGING_APPENDER" source="logging.appender"/>
    <springProperty scope="context" name="LOG_FILE_PATH" source="logging.file.path"/>
    <springProperty scope="context" name="LOGGING_FILE_NAME_APPLICATION"
        source="logging.file.application"/>

    <property name="LOG_PATTERN_FILE_APPLICATION"
        value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level ${hostname} %X{REQUEST_ID} %X{HTTP_METHOD} %X{REQUEST_URI} %X{GROUP_TYPE_NUMBER} %X{SERVICE_API_KEY} %X{USER_ID} %X{GROUP_ID} %X{SESSION_ID}  %c{2} : %msg%n"/>
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <pattern>
                    <pattern>
                        {
                        "type":"%X{TYPE:-application}",
                        "eventTime":"%d{yyyy-MM-dd HH:mm:ss.SSS}",
                        "hostName":"${hostname}",
                        "requestId":"%X{REQUEST_ID}",
                        "httpMethod":"%X{HTTP_METHOD}",
                        "requestUri":"%X{REQUEST_URI}",
                        "groupTypeNumber":"%X{GROUP_TYPE_NUMBER}",
                        "serviceApiKey":"%X{SERVICE_API_KEY}",
                        "userId":"%X{USER_ID}",
                        "groupId":"%X{GROUP_ID}",
                        "sessionId":"%X{SESSION_ID}",
                        "level": "%level",
                        "logger": "%logger",
                        "message":"%msg",
                        "stackTrace":"%ex{10}"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>
    <appender name="file_error" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN_FILE_APPLICATION}</pattern>
        </encoder>
        <file>${LOG_FILE_PATH}${LOGGING_FILE_NAME_APPLICATION}_application.err</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_FILE_PATH}${LOGGING_FILE_NAME_APPLICATION}_application.%d{yyyy-MM-dd}.err
            </fileNamePattern>
            <maxHistory>365</maxHistory>
        </rollingPolicy>
    </appender>

    <appender name="file_info" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN_FILE_APPLICATION}</pattern>
        </encoder>
        <file>${LOG_FILE_PATH}${LOGGING_FILE_NAME_APPLICATION}_application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_FILE_PATH}${LOGGING_FILE_NAME_APPLICATION}_application.%d{yyyy-MM-dd_HH}.log
            </fileNamePattern>
            <maxHistory>12</maxHistory>
        </rollingPolicy>
    </appender>
    <root level="${LOG_LEVEL}">
        <if condition='property("LOGGING_APPENDER").contains("console")'>
            <then>
                <appender-ref ref="console" />
            </then>
            <else>
                <appender-ref ref="file_error" />
                <appender-ref ref="file_info" />
            </else>
        </if>
    </root>
</configuration>
